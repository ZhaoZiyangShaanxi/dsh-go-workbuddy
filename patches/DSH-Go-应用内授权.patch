diff --git a/app/test/plugins/native/workbuddy_login_link_test.dart b/app/test/plugins/native/workbuddy_login_link_test.dart
new file mode 100644
index 00000000..c11835fc
--- /dev/null
+++ b/app/test/plugins/native/workbuddy_login_link_test.dart
@@ -0,0 +1,43 @@
+import 'package:dsh_app/ui/plugins/native/native_taps.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('WorkBuddy state-bound login stays inside DSH Go', () {
+    for (final package in ['dsh-connect-workbuddy', 'dsh-go-workbuddy']) {
+      for (final host in ['www.codebuddy.cn', 'www.workbuddy.ai', 'www.codebuddy.ai']) {
+        expect(
+          isWorkBuddyInAppLoginLink(package, Uri.parse('https://$host/login?state=abc')),
+          isTrue,
+        );
+      }
+    }
+  });
+
+  test('unrelated and deceptive links keep the external browser path', () {
+    for (final url in [
+      'http://www.codebuddy.cn/login?state=abc',
+      'https://www.codebuddy.cn/login',
+      'https://www.codebuddy.cn/login?state=',
+      'https://www.codebuddy.cn.evil.example/login?state=abc',
+      'https://www.codebuddy.cn:8443/login?state=abc',
+      'https://www.codebuddy.cn/account?state=abc',
+    ]) {
+      expect(
+        isWorkBuddyInAppLoginLink('dsh-connect-workbuddy', Uri.parse(url)),
+        isFalse,
+        reason: url,
+      );
+    }
+    expect(
+      isWorkBuddyInAppLoginLink(
+        'dsh-connect-workbuddy',
+        Uri(scheme: 'https', host: 'www.codebuddy.cn', userInfo: 'user', path: '/login', queryParameters: {'state': 'abc'}),
+      ),
+      isFalse,
+    );
+    expect(
+      isWorkBuddyInAppLoginLink('another-plugin', Uri.parse('https://www.codebuddy.cn/login?state=abc')),
+      isFalse,
+    );
+  });
+}
