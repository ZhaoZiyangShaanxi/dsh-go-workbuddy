+/// Only WorkBuddy's state-bound login page may use the in-app browser.
+bool isWorkBuddyInAppLoginLink(String package, Uri url) =>
+    const {'dsh-connect-workbuddy', 'dsh-go-workbuddy'}.contains(package) &&
+    url.scheme == 'https' &&
+    url.userInfo.isEmpty &&
+    (!url.hasPort || url.port == 443) &&
+    url.path == '/login' &&
+    (url.queryParameters['state']?.isNotEmpty ?? false) &&
+    const {
+      'codebuddy.cn',
+      'www.codebuddy.cn',
+      'workbuddy.cn',
+      'www.workbuddy.cn',
+      'codebuddy.ai',
+      'www.codebuddy.ai',
+      'workbuddy.ai',
+      'www.workbuddy.ai',
+    }.contains(url.host.toLowerCase());
